# Copy to .env (gitignored) and fill in for your machine. Never commit .env.

# Absolute path to a local directory of real photographs/images used as test
# fixtures for verification tasks (e.g. T02) and later domain/pipeline tests.
# Read-only: nothing in this repo should ever write into, move, or delete
# anything under this path. See AGENTS.md "Test/verification photo fixtures".
PHOTO_FIXTURES_DIR=

# Canonical production base URL (no trailing slash), e.g. https://massimg.com.
# Read by src/config/site.ts (Technical Design §12.2). Left unset here so a
# local or staging build never claims to be the production URL in canonical
# tags, JSON-LD or sitemap.xml — it falls back to an unmistakably-non-production
# placeholder instead of throwing.
VITE_SITE_BASE_URL=
