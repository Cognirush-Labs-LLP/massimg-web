{
  "name": "icompress-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mass image compressor: a client-side, local-processing web app for batch image compression, resizing and format conversion.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build && node scripts/generate-seo-files.mjs",
    "preview": "vite preview",
    "verify:ssg": "node scripts/verify-ssg-html.mjs",
    "type-check": "vue-tsc -b --force",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "vue-tsc -b --force && eslint . && stylelint \"src/**/*.{css,vue}\" && prettier --check .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@imagemagick/magick-wasm": "0.0.43",
    "@unhead/vue": "^2.1.17",
    "apng-optimizer": "1.2.0",
    "client-zip": "2.5.1",
    "gifsicle-wasm-browser": "1.5.19",
    "imagequant": "0.1.2",
    "markdown-it": "^15.0.2",
    "pinia": "^4.0.3",
    "upng-js": "2.1.0",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "browserslist": "^4.29.3",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-vue": "^10.11.0",
    "js-yaml": "4.3.2",
    "jsdom": "^30.0.1",
    "postcss-html": "2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "15.0.0",
    "stylelint-use-logical-spec": "5.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
